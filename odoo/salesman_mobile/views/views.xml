<odoo>
  <record id="view_users_salesman" model="ir.ui.view">
    <field name="name">res.users.salesman</field><field name="model">res.users</field>
    <field name="inherit_id" ref="base.view_users_form"/>
    <field name="arch" type="xml"><xpath expr="//notebook" position="inside">
      <page string="Salesman"><group><field name="salesman_location_id"/></group></page></xpath></field>
  </record>
  <record id="view_req_tree" model="ir.ui.view">
    <field name="name">salesman.customer.request.tree</field><field name="model">salesman.customer.request</field>
    <field name="arch" type="xml"><tree><field name="partner_id"/><field name="product_id"/><field name="qty"/><field name="user_id"/><field name="source"/><field name="state"/></tree></field>
  </record>
  <record id="action_req" model="ir.actions.act_window">
    <field name="name">Customer Requests</field><field name="res_model">salesman.customer.request</field><field name="view_mode">tree,form</field>
  </record>
  <menuitem id="menu_req" name="Customer Requests" parent="sale.sale_order_menu" action="action_req"/>
  <record id="param_radius" model="ir.config_parameter"><field name="key">salesman_mobile.radius_m</field><field name="value">50</field></record>
</odoo>
